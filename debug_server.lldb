breakpoint set --name unpackPayloadOPN
breakpoint command add 1
  print channel->securityPolicy
  print channel->state
  print chunk->messageType
  print chunk->bytes.length
  continue
end

breakpoint set --name configServerSecureChannel
breakpoint command add 2
  print channel->securityPolicy
  print securityPolicy
  print appInstCert.length
  continue
end

breakpoint set --name UA_SecureChannel_setSecurityPolicy
breakpoint command add 3
  print channel->securityPolicy
  print securityPolicy
  print remoteCertificate->length
  continue
end

run


